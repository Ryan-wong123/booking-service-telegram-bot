# Copy to .env for local/docker-compose use. NEVER commit .env.
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://booking:change-me@db:5432/booking
APP_TIMEZONE=Asia/Singapore
MAX_ACTIVE_BOOKINGS=3
ALLOW_REGISTRATION=true

# First super admin, created by `flask init-db` only if no super admin exists yet
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-to-a-long-password

# Optional Zoom (Server-to-Server OAuth app). Leave blank to disable.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
