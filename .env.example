# Copy to .env for local or production docker compose. NEVER commit .env. (chmod 600 on the server)
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
# docker-compose builds DATABASE_URL from POSTGRES_PASSWORD. For other setups use:
# DATABASE_URL=postgresql://booking:PASSWORD@HOST:5432/booking
APP_TIMEZONE=Asia/Singapore
MAX_ACTIVE_BOOKINGS=3
ALLOW_REGISTRATION=true

# First super admin, created by `flask init-db` only if no super admin exists yet
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-to-a-long-password

# Optional Zoom (Server-to-Server OAuth app). Leave blank to disable.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Email (Amazon SES SMTP or any SMTP server). Leave SMTP_HOST empty to disable email
# (then password-reset, confirmations and reminders are not sent).
APP_BASE_URL=http://localhost:8000
MAIL_FROM=Booking Portal <no-reply@yourdomain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
REMINDER_HOURS=24
# Local email testing: `docker compose --profile dev up` starts Mailpit (UI http://localhost:8025);
# then set SMTP_HOST=mailpit SMTP_PORT=1025 SMTP_STARTTLS=false

# --- Production only (docker-compose.prod.yml) ---
# APP_ENV=production  (also set APP_BASE_URL=https://your.domain, and SESSION_COOKIE_SECURE stays on)
DOMAIN=booking.example.com
ACME_EMAIL=you@example.com
# Nightly S3 backup (uses the EC2 instance role; no AWS keys)
S3_BUCKET=
S3_PREFIX=booking
AWS_DEFAULT_REGION=ap-southeast-1
